# Backend environment variables
# Copy to .env and fill in real values.

# ─── Supabase connection strings ────────────────────────────────────────────
# In Supabase: Project Settings → Database → Connection string
#
# 1) "Transaction pooler" (port 6543) — use for DATABASE_URL (runtime queries).
#    Append ?pgbouncer=true&connection_limit=1 so Prisma works with the pool.
#
# 2) "Session pooler" or "Direct connection" (port 5432) — use for DIRECT_URL
#    (Prisma migrations). Append ?sslmode=require for Supabase.
#
# Example:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_shop_ledger?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smart_shop_ledger?schema=public"

# ─── App config ─────────────────────────────────────────────────────────────
# JWT secret used to sign access tokens. Use a long random string in prod.
# Generate one with:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Port the Express server listens on. Render injects PORT automatically.
PORT=3000

# Comma-separated list of allowed CORS origins.
# For Flutter Android emulator hitting localhost: http://10.0.2.2:3000
# For your deployed Render backend + Flutter app: "*" (or list specific origins)
CORS_ORIGIN="*"
