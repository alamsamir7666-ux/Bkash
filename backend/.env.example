# Backend environment variables
# Copy to .env and fill in real values.

# PostgreSQL connection string.
# Local: postgresql://postgres:postgres@localhost:5432/smart_shop_ledger?schema=public
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_shop_ledger?schema=public"

# JWT secret used to sign access tokens. Use a long random string in prod.
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Port the Express server listens on.
PORT=3000

# Comma-separated list of allowed CORS origins.
# For Flutter web: http://localhost:3000,http://localhost:8080
# For Android emulator hitting localhost: http://10.0.2.2:3000
CORS_ORIGIN="*"
